NODE_ENV=development
PORT=3000

BOT_TOKEN=your_telegram_bot_token
ADMIN_CHAT_ID=your_admin_chat_id

DEEPSEEK_API_KEY=your_deepseek_api_key
LOG_LEVEL=info

# Webhook Configuration
# WEBHOOK_URL must be a public HTTPS URL (not localhost!)
# Example: https://your-domain.com/webhooks/telegram
WEBHOOK_URL=http://your-domain.com/webhooks/telegram

# S3 Configuration (AWS S3, Minio, DigitalOcean Spaces, etc.)
# For AWS S3: https://s3.amazonaws.com or https://s3-region.amazonaws.com
# For Minio: http://localhost:9000 or http://your-minio-server:9000
# For DigitalOcean Spaces: https://your-space-name.region.digitaloceanspaces.com
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET=telegram-media
S3_USE_SSL=true
S3_FORCE_PATH_STYLE=true
